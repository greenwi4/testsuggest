{
  "openapi": "3.1.0",
  "info": {
    "title": "Formatting Repro API",
    "version": "1.0.0",
    "description": "Minimal OpenAPI spec for testing formatting-only diffs in ReadMe."
  },
  "servers": [
    {
      "url": "https://example.com/api"
    }
  ],
  "tags": [
    {
      "name": "Formatting Repro",
      "description": "Operations for reproducing formatting diffs in API reference pages."
    }
  ],
  "paths": {
    "/campaigns": {
      "get": {
        "tags": [
          "Formatting Repro"
        ],
        "summary": "Get campaigns",
        "description": "Get a list of campaigns.\n",
        "operationId": "GET_campaigns",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter the returned campaigns by status.\n",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "paused",
                "canceled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/campaigns/{id}": {
      "get": {
        "tags": [
          "Formatting Repro"
        ],
        "summary": "Get campaign",
        "description": "Get a single campaign by ID.\n",
        "operationId": "GET_campaignById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique campaign ID.\n",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/campaigns/{id}/pause": {
      "post": {
        "tags": [
          "Formatting Repro"
        ],
        "summary": "Pause campaign",
        "description": "Pause a campaign.\n",
        "operationId": "POST_pauseCampaign",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique campaign ID.\n",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    }
  }
}